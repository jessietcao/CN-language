整数 主函数 () {
    整数 甲=5。
    小数 价格=19.99。
    字符串 名字="张爱玲"。
    是非 正编程=真。
    输入（甲）。
    如果 (甲 > 3) {
        输出 ("大于三【回车】")。
    } 否则 (甲 == 3) {
        输出 ("等于三【回车】")。
    } 其他 {
        输出 ("小于三【回车】")。
    }
    当 (甲 < 10) {
        甲++。
    }
    循环 (整数 乙=0; 乙<=10; 乙++) {
        甲 = 甲 + 乙 * 2。
    }
    返回 0。
}